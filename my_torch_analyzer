#!/bin/python3
"""
    main.py
    Entry point of the project
"""

import sys
from source.analyzer.modes import split_train_args, is_help_flag, is_predict_flag, is_train_flag
#from source.analyzer.predict import run_predict
#from source.analyzer.train import run_train

from source.common.constants import (
    ERROR,
    NOERROR,
    HELP_TEXT
)

def main():
    args = sys.argv
    n_arg = len(args)
    if n_arg < 2:
        print("Missing arguments, try --help", file=sys.stderr)
        sys.exit(ERROR)

    main_flag = args[1]
    if is_help_flag(main_flag, n_arg):
        print(HELP_TEXT)
        sys.exit(NOERROR)

    files_path = args[2:]
    if is_predict_flag(main_flag, n_arg, files_path):
        #run_predict(files_path[0], files_path[1])
        sys.exit(NOERROR)
    elif is_train_flag(main_flag, n_arg, files_path):
        loadfile, chessfile, savefile = split_train_args(files_path)
        #run_train(loadfile, chessfile, savefile)
        sys.exit(NOERROR)
    else:
        print("An unknown argument was given", file=sys.stderr)
        sys.exit(ERROR)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(ERROR)
    except Exception as err:
        print(f"{err}", file=sys.stderr)
        sys.exit(ERROR)