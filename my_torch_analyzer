#!/bin/python3
"""
    main.py
    main file of the project
"""

import sys
from source.common.constants import (
    ERROR,
    NOERROR,
    HELP_TEXT,
    MAIN_ACCEPTED_FLAGS,
)
from source.common.utils import (
    is_help_flag,
    is_predict_flag,
    is_train_flag,
)


def main():
    args = sys.argv
    n_arg = len(args)
    if n_arg < 2:
        print("Missing arguments, try --help", file=sys.stderr)
        sys.exit(ERROR)
    main_flag = args[1]
    if is_help_flag(main_flag, n_arg):
        print(HELP_TEXT)
        sys.exit(NOERROR)
    files_path = args[2:]
    if is_predict_flag(main_flag, n_arg, files_path):
        print(HELP_TEXT)
        sys.exit(NOERROR)
    elif is_train_flag(main_flag, n_arg, files_path):
        print(HELP_TEXT)
        sys.exit(NOERROR)
    else:
        print("An unknow argument was given",  file=sys.stderr)
        sys.exit(ERROR)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(ERROR)
    except Exception as err:
        print(f"{err}", file=sys.stderr)
        sys.exit(ERROR)